}

QFrame#EventsStatusBanner {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
}

QFrame#EventsStatusBanner[state="loading"] {
    border-color: {{BORDER}};
