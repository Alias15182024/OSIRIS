}

QPushButton#LoginSubmitButton:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#LoginSubmitButton:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#LoginSubmitButton:disabled {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QPushButton#LoginCancelButton {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_2}}px {{SPACE_4}}px;
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
    min-height: {{SPACE_7}}px;
}

QPushButton#LoginCancelButton:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border-color: {{BORDER}};
}

QPushButton#LoginCancelButton:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QPushButton#LoginCancelButton:disabled {
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

