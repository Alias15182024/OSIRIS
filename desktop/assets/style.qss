}

QLabel#SeverityFilterLabel,
QLabel#SourceFilterLabel,
QLabel#EventTypeFilterLabel,
QLabel#PidFilterLabel,
QLabel#HostIdFilterLabel,
QLabel#StartTimeFilterLabel,
QLabel#EndTimeFilterLabel {
