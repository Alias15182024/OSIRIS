/* =============================================================================
   OSIRIS Native Desktop QSS Foundation
   Design Token Source: desktop/ui/design_tokens.py
   Palette: Surface0={{SURFACE_0}}, Surface1={{SURFACE_1}}, Surface2={{SURFACE_2}},
            Surface3={{SURFACE_3}}, Border={{BORDER}}
   Text:    Primary={{TEXT_PRIMARY}}, Secondary={{TEXT_SECONDARY}}
   Accent:  Accent={{ACCENT}}, Focus={{ACCENT_FOCUS}}
   ============================================================================= */

/* -----------------------------------------------------------------------------
   1. Base Application & Window Foundations
   ----------------------------------------------------------------------------- */

QWidget {
    background-color: {{SURFACE_0}};
    color: {{TEXT_PRIMARY}};
    font-family: {{FONT_FAMILY_SANS}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

QMainWindow {
    background-color: {{SURFACE_0}};
    color: {{TEXT_PRIMARY}};
}

/* -----------------------------------------------------------------------------
   2. Typography & Label Foundations
   ----------------------------------------------------------------------------- */

QLabel {
    background-color: transparent;
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    padding: 0px;
}

QLabel:disabled {
    color: {{TEXT_SECONDARY}};
}

/* Secondary / Subdued Metadata Hierarchy */
QLabel[secondary="true"],
QLabel[subdued="true"] {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

/* Section Title Hierarchy */
QLabel[section="true"],
QLabel[heading="true"] {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SECTION_TITLE}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

/* Major Heading Hierarchy */
QLabel[major="true"],
QLabel[title="true"] {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_MAJOR_HEADING}}px;
    font-weight: {{FONT_WEIGHT_BOLD}};
}

/* Monospace / KPI Metric Hierarchy */
QLabel[metric="true"],
QLabel[monospace="true"] {
    font-family: {{FONT_FAMILY_MONO}};
    font-size: {{FONT_SIZE_NUMERIC_METRIC}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

/* Semantic Severity Text Indicators */
QLabel[severity="critical"] {
    color: {{SEVERITY_CRITICAL}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[severity="high"] {
    color: {{SEVERITY_HIGH}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[severity="medium"] {
    color: {{SEVERITY_MEDIUM}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[severity="low"] {
    color: {{SEVERITY_LOW}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[severity="info"] {
    color: {{SEVERITY_INFO}};
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

/* Operational Status Text Indicators */
QLabel[status="fresh"] {
    color: {{STATUS_FRESH}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[status="stale"] {
    color: {{STATUS_STALE}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[status="degraded"] {
    color: {{STATUS_DEGRADED}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel[status="offline"] {
    color: {{STATUS_OFFLINE}};
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

/* -----------------------------------------------------------------------------
   3. Text Inputs
   ----------------------------------------------------------------------------- */

QLineEdit {
    background-color: {{SURFACE_1}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    min-height: {{SPACE_5}}px;
    selection-background-color: {{ACCENT}};
    selection-color: {{TEXT_PRIMARY}};
}

QLineEdit:hover {
    border: 1px solid {{SURFACE_3}};
    background-color: {{SURFACE_1}};
}

QLineEdit:focus {
    border: 1px solid {{ACCENT_FOCUS}};
    background-color: {{SURFACE_2}};
}

QLineEdit:read-only {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
}

QLineEdit:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
}

/* -----------------------------------------------------------------------------
   4. Buttons & Interactive Controls
   ----------------------------------------------------------------------------- */

QPushButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    min-height: {{SPACE_5}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    outline: none;
}

QPushButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QPushButton:pressed {
    background-color: {{SURFACE_1}};
    border-color: {{ACCENT}};
}

QPushButton:focus {
    border: 1px solid {{ACCENT_FOCUS}};
}

QPushButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* Primary Button Styling */
QPushButton:default,
QPushButton[primary="true"] {
    background-color: {{ACCENT}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{ACCENT}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QPushButton:default:hover,
QPushButton[primary="true"]:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QPushButton:default:pressed,
QPushButton[primary="true"]:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QPushButton:default:focus,
QPushButton[primary="true"]:focus {
    border: 1px solid {{TEXT_PRIMARY}};
}

QPushButton:default:disabled,
QPushButton[primary="true"]:disabled {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* -----------------------------------------------------------------------------
   5. Tool Buttons
   ----------------------------------------------------------------------------- */

QToolButton {
    background-color: transparent;
    color: {{TEXT_PRIMARY}};
    border: 1px solid transparent;
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px;
    min-height: {{SPACE_5}}px;
    min-width: {{SPACE_5}}px;
    outline: none;
}

QToolButton:hover {
    background-color: {{SURFACE_2}};
    border-color: {{BORDER}};
}

QToolButton:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QToolButton:checked {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
    color: {{TEXT_PRIMARY}};
}

QToolButton:focus {
    border: 1px solid {{ACCENT_FOCUS}};
}

QToolButton:disabled {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border-color: transparent;
}

/* -----------------------------------------------------------------------------
   6. Dropdowns / Selection Controls
   ----------------------------------------------------------------------------- */

QComboBox {
    background-color: {{SURFACE_1}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    min-height: {{SPACE_5}}px;
}

QComboBox:hover {
    border-color: {{SURFACE_3}};
}

QComboBox:focus {
    border: 1px solid {{ACCENT_FOCUS}};
}

QComboBox:on {
    border-color: {{ACCENT_FOCUS}};
    background-color: {{SURFACE_2}};
}

QComboBox:pressed {
    background-color: {{SURFACE_2}};
}

QComboBox:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: {{SPACE_5}}px;
    border-left: 1px solid {{BORDER}};
    border-top-right-radius: {{RADIUS_MEDIUM}}px;
    border-bottom-right-radius: {{RADIUS_MEDIUM}}px;
    background-color: transparent;
}

QComboBox::drop-down:hover {
    background-color: {{SURFACE_2}};
}

QComboBox::drop-down:pressed {
    background-color: {{SURFACE_3}};
}

QComboBox::down-arrow {
    width: {{SPACE_2}}px;
    height: {{SPACE_2}}px;
}

QComboBox QAbstractItemView {
    background-color: {{SURFACE_1}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{SURFACE_3}};
    selection-color: {{TEXT_PRIMARY}};
    padding: {{SPACE_1}}px;
    outline: none;
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{SURFACE_2}};
}

/* -----------------------------------------------------------------------------
   7. Checkboxes
   ----------------------------------------------------------------------------- */

QCheckBox {
    color: {{TEXT_PRIMARY}};
    background-color: transparent;
    spacing: {{SPACE_2}}px;
    outline: none;
}

QCheckBox:disabled {
    color: {{TEXT_SECONDARY}};
}

QCheckBox:focus {
    color: {{TEXT_PRIMARY}};
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    background-color: {{SURFACE_1}};
}

QCheckBox::indicator:hover {
    border-color: {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QCheckBox::indicator:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QCheckBox::indicator:focus {
    border-color: {{ACCENT_FOCUS}};
}

QCheckBox::indicator:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
}

QCheckBox::indicator:checked:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QCheckBox::indicator:checked:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT_FOCUS}};
}

QCheckBox::indicator:indeterminate {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
}

QCheckBox::indicator:indeterminate:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QCheckBox::indicator:indeterminate:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QCheckBox::indicator:disabled {
    background-color: {{SURFACE_0}};
    border-color: {{BORDER}};
}

/* -----------------------------------------------------------------------------
   8. Radio Buttons
   ----------------------------------------------------------------------------- */

QRadioButton {
    color: {{TEXT_PRIMARY}};
    background-color: transparent;
    spacing: {{SPACE_2}}px;
    outline: none;
}

QRadioButton:disabled {
    color: {{TEXT_SECONDARY}};
}

QRadioButton:focus {
    color: {{TEXT_PRIMARY}};
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_FULL}}px;
    background-color: {{SURFACE_1}};
}

QRadioButton::indicator:hover {
    border-color: {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QRadioButton::indicator:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QRadioButton::indicator:focus {
    border-color: {{ACCENT_FOCUS}};
}

QRadioButton::indicator:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
}

QRadioButton::indicator:checked:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QRadioButton::indicator:checked:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT_FOCUS}};
}

QRadioButton::indicator:disabled {
    background-color: {{SURFACE_0}};
    border-color: {{BORDER}};
}

/* -----------------------------------------------------------------------------
   9. Scrollbars
   ----------------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: {{SURFACE_0}};
    width: {{SPACE_2}}px;
    margin: 0px;
    border: none;
}

QScrollBar:vertical:disabled {
    background-color: {{SURFACE_0}};
}

QScrollBar::handle:vertical {
    background-color: {{BORDER}};
    min-height: {{SPACE_6}}px;
    border-radius: {{RADIUS_SMALL}}px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{SURFACE_3}};
}

QScrollBar::handle:vertical:pressed {
    background-color: {{ACCENT}};
}

QScrollBar::handle:vertical:disabled {
    background-color: {{SURFACE_1}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: {{SURFACE_0}};
    height: {{SPACE_2}}px;
    margin: 0px;
    border: none;
}

QScrollBar:horizontal:disabled {
    background-color: {{SURFACE_0}};
}

QScrollBar::handle:horizontal {
    background-color: {{BORDER}};
    min-width: {{SPACE_6}}px;
    border-radius: {{RADIUS_SMALL}}px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{SURFACE_3}};
}

QScrollBar::handle:horizontal:pressed {
    background-color: {{ACCENT}};
}

QScrollBar::handle:horizontal:disabled {
    background-color: {{SURFACE_1}};
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* -----------------------------------------------------------------------------
   10. Structural Frames & Dividers
   ----------------------------------------------------------------------------- */

QFrame {
    border: none;
}

/* Panel surface containers */
QFrame[panel="true"] {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
}

QFrame[surface="0"] {
    background-color: {{SURFACE_0}};
}

QFrame[surface="1"] {
    background-color: {{SURFACE_1}};
}

QFrame[surface="2"] {
    background-color: {{SURFACE_2}};
}

QFrame[surface="3"] {
    background-color: {{SURFACE_3}};
}

/* Dividers and structural separators */
QFrame#separator,
QFrame[separator="true"],
QFrame[separator="horizontal"],
QFrame[orientation="horizontal"],
QFrame[frameShape="4"] {
    background-color: {{BORDER}};
    color: {{BORDER}};
    max-height: 1px;
    height: 1px;
    border: none;
}

QFrame[separator="vertical"],
QFrame[orientation="vertical"],
QFrame[frameShape="5"] {
    background-color: {{BORDER}};
    color: {{BORDER}};
    max-width: 1px;
    width: 1px;
    border: none;
}

/* -----------------------------------------------------------------------------
   11. Abstract Item Views Base
   ----------------------------------------------------------------------------- */

QAbstractItemView {
    background-color: {{SURFACE_0}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{SURFACE_3}};
    selection-color: {{TEXT_PRIMARY}};
    outline: none;
}

QAbstractItemView:focus {
    border-color: {{ACCENT_FOCUS}};
}

QAbstractItemView:disabled {
    color: {{TEXT_SECONDARY}};
    background-color: {{SURFACE_0}};
}

QAbstractItemView::item {
    padding: {{SPACE_1}}px {{SPACE_2}}px;
}

QAbstractItemView::item:hover {
    background-color: {{SURFACE_2}};
}

QAbstractItemView::item:selected {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
}

QAbstractItemView::item:selected:focus {
    background-color: {{SURFACE_3}};
    border: 1px solid {{ACCENT_FOCUS}};
}

QAbstractItemView::item:disabled {
    color: {{TEXT_SECONDARY}};
}

/* -----------------------------------------------------------------------------
   12. Dense Investigator Tables
   ----------------------------------------------------------------------------- */

QTableView {
    background-color: {{SURFACE_0}};
    alternate-background-color: {{SURFACE_1}};
    color: {{TEXT_PRIMARY}};
    gridline-color: {{BORDER}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{SURFACE_3}};
    selection-color: {{TEXT_PRIMARY}};
    outline: none;
}

QTableView:focus {
    border-color: {{ACCENT_FOCUS}};
}

QTableView:disabled {
    color: {{TEXT_SECONDARY}};
    background-color: {{SURFACE_0}};
}

/* Compact investigator console row height (~28px target) */
QTableView::item {
    min-height: {{TABLE_ROW_HEIGHT}}px;
    height: {{TABLE_ROW_HEIGHT}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    border-bottom: 1px solid {{BORDER}};
}

QTableView::item:hover {
    background-color: {{SURFACE_2}};
}

QTableView::item:selected {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
}

QTableView::item:selected:focus {
    background-color: {{SURFACE_3}};
    border: 1px solid {{ACCENT_FOCUS}};
}

QTableView::item:disabled {
    color: {{TEXT_SECONDARY}};
}

QTableView QTableCornerButton::section {
    background-color: {{SURFACE_1}};
    border: none;
    border-right: 1px solid {{BORDER}};
    border-bottom: 1px solid {{BORDER}};
}

/* -----------------------------------------------------------------------------
   13. Headers
   ----------------------------------------------------------------------------- */

QHeaderView {
    background-color: {{SURFACE_1}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QHeaderView::section {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    border: none;
    border-right: 1px solid {{BORDER}};
    border-bottom: 1px solid {{BORDER}};
    min-height: {{SPACE_6}}px;
}

QHeaderView::section:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
}

QHeaderView::section:pressed {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QHeaderView::section:checked {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QHeaderView::section:disabled {
    color: {{TEXT_SECONDARY}};
    background-color: {{SURFACE_1}};
}

/* -----------------------------------------------------------------------------
   14. Tree Views
   ----------------------------------------------------------------------------- */

QTreeView {
    background-color: {{SURFACE_0}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{SURFACE_3}};
    selection-color: {{TEXT_PRIMARY}};
    outline: none;
}

QTreeView:focus {
    border-color: {{ACCENT_FOCUS}};
}

QTreeView:disabled {
    color: {{TEXT_SECONDARY}};
    background-color: {{SURFACE_0}};
}

QTreeView::item {
    min-height: {{TABLE_ROW_HEIGHT}}px;
    height: {{TABLE_ROW_HEIGHT}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
}

QTreeView::item:hover {
    background-color: {{SURFACE_2}};
}

QTreeView::item:selected {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
}

QTreeView::item:selected:focus {
    background-color: {{SURFACE_3}};
    border: 1px solid {{ACCENT_FOCUS}};
}

QTreeView::branch:hover {
    background-color: {{SURFACE_2}};
}

QTreeView::branch:selected {
    background-color: {{SURFACE_3}};
}

QTreeView::item:disabled {
    color: {{TEXT_SECONDARY}};
}

/* -----------------------------------------------------------------------------
   15. Status Bar
   ----------------------------------------------------------------------------- */

QStatusBar {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-top: 1px solid {{BORDER}};
    min-height: {{STATUS_BAR_HEIGHT}}px;
    max-height: {{STATUS_BAR_HEIGHT}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    padding: 0px {{SPACE_2}}px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

/* -----------------------------------------------------------------------------
   16. Reusable Base Components: Badges & Metric Cards
   ----------------------------------------------------------------------------- */

/* SeverityBadge Foundation */
QLabel#SeverityBadge {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_2}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#SeverityBadge[severity="critical"] {
    color: {{SEVERITY_CRITICAL}};
    border-color: {{SEVERITY_CRITICAL}};
}

QLabel#SeverityBadge[severity="high"] {
    color: {{SEVERITY_HIGH}};
    border-color: {{SEVERITY_HIGH}};
}

QLabel#SeverityBadge[severity="medium"] {
    color: {{SEVERITY_MEDIUM}};
    border-color: {{SEVERITY_MEDIUM}};
}

QLabel#SeverityBadge[severity="low"] {
    color: {{SEVERITY_LOW}};
    border-color: {{SEVERITY_LOW}};
}

QLabel#SeverityBadge[severity="info"] {
    color: {{SEVERITY_INFO}};
    border-color: {{BORDER}};
}

QLabel#SeverityBadge:disabled {
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
    background-color: {{SURFACE_1}};
}

/* StatusBadge Foundation */
QLabel#StatusBadge {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_2}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#StatusBadge[status="fresh"] {
    color: {{STATUS_FRESH}};
    border-color: {{STATUS_FRESH}};
}

QLabel#StatusBadge[status="stale"] {
    color: {{STATUS_STALE}};
    border-color: {{STATUS_STALE}};
}

QLabel#StatusBadge[status="degraded"] {
    color: {{STATUS_DEGRADED}};
    border-color: {{STATUS_DEGRADED}};
}

QLabel#StatusBadge[status="offline"] {
    color: {{STATUS_OFFLINE}};
    border-color: {{BORDER}};
}

QLabel#StatusBadge:disabled {
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
    background-color: {{SURFACE_1}};
}

/* MetricCard Foundation */
QFrame#MetricCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
}

QFrame#MetricCard:disabled {
    background-color: {{SURFACE_0}};
    border-color: {{BORDER}};
}

QLabel#MetricCardTitle {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#MetricCardValue {
    color: {{TEXT_PRIMARY}};
    font-family: {{FONT_FAMILY_MONO}};
    font-size: {{FONT_SIZE_NUMERIC_METRIC}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#MetricCardDetail {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

/* -----------------------------------------------------------------------------
   17. Application Shell & Navigation (0.3.4)
   ----------------------------------------------------------------------------- */

QWidget#AppShell {
    background-color: {{SURFACE_0}};
}

QWidget#ContentArea {
    background-color: {{SURFACE_0}};
}

/* Left Navigation Panel */
QFrame#LeftNav {
    background-color: {{SURFACE_1}};
    border: none;
    border-right: 1px solid {{BORDER}};
}

QLabel#NavBrandTitle {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SECTION_TITLE}}px;
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QLabel#NavBrandSubtitle {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

/* Navigation Buttons */
QPushButton[navItem] {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_2}}px {{SPACE_3}}px;
    text-align: left;
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_7}}px;
}

QPushButton[navItem]:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border-left: 3px solid {{SURFACE_3}};
}

QPushButton[navItem]:checked {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border-left: 3px solid {{ACCENT}};
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QPushButton[navItem]:focus {
    border-color: {{ACCENT_FOCUS}};
}

/* Top Header */
QFrame#TopHeader {
    background-color: {{SURFACE_1}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QLabel#HeaderTitle {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#HeaderSeparator {
    color: {{BORDER}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
}

QLabel#HeaderContext {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#HeaderModeBadge {
    background-color: {{SURFACE_2}};
    color: {{ACCENT}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_2}}px;
    font-size: 10px;
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QLabel#HeaderModeBadge[authenticated="true"] {
    color: {{STATUS_FRESH}};
    border-color: {{BORDER}};
}

QLabel#UserIdentityLabel {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
    padding: 0px {{SPACE_1}}px;
}

QLabel#UserRoleBadge {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_2}}px;
    font-size: 10px;
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QLabel#UserRoleBadge[role="admin"] {
    color: {{ACCENT_FOCUS}};
    border-color: {{BORDER}};
}

QPushButton#LogoutButton {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#LogoutButton:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border-color: {{BORDER}};
}

QPushButton#LogoutButton:pressed {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QPushButton#LogoutButton:focus {
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#LogoutButton:disabled {
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* Contextual Toolbar */
QFrame#ContextualToolbar {
    background-color: {{SURFACE_0}};
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QLabel#ToolbarContextLabel {
