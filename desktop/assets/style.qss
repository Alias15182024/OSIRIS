}

QLabel#ToolbarSeparator {
    color: {{BORDER}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
}

QLabel#ToolbarSubContextLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QPushButton#ToolbarAction_Refresh {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_2}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    min-height: {{SPACE_6}}px;
}

QPushButton#ToolbarAction_Refresh:disabled {
    color: {{TEXT_SECONDARY}};
    background-color: {{SURFACE_1}};
    border-color: {{BORDER}};
}

QPushButton#CheckStatusButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: 2px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#CheckStatusButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QPushButton#CheckStatusButton:pressed {
    background-color: {{SURFACE_1}};
    border-color: {{ACCENT}};
}

QPushButton#CheckStatusButton:focus {
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#CheckStatusButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* Main Content Area */
QStackedWidget#MainContentStack {
    background-color: {{SURFACE_0}};
}

QLabel#PageTitle {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_MAJOR_HEADING}}px;
    font-weight: {{FONT_WEIGHT_BOLD}};
}

QLabel#PageDescription {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
}

/* Empty State Card */
QFrame#EmptyStateFrame {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
}

QLabel#EmptyStateTitle {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SECTION_TITLE}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#EmptyStateMessage {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
}

/* Bottom Status Bar */
QFrame#BottomStatusBar {
    background-color: {{SURFACE_1}};
    border: none;
    border-top: 1px solid {{BORDER}};
}

QLabel#StatusModeLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusSeparator {
    color: {{BORDER}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#StatusApiLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#StatusApiLabel[apiState="reachable"] {
    color: {{STATUS_FRESH}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusApiLabel[apiState="unavailable"] {
    color: {{STATUS_DEGRADED}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusApiLabel[apiState="checking"] {
    color: {{STATUS_STALE}};
}

QLabel#StatusSystemLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#StatusSystemLabel[systemState="healthy"] {
    color: {{STATUS_FRESH}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusSystemLabel[systemState="degraded"] {
    color: {{STATUS_STALE}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusSystemLabel[systemState="unavailable"] {
    color: {{STATUS_DEGRADED}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusSystemLabel[systemState="checking"] {
    color: {{STATUS_STALE}};
}

QLabel#StatusDatabaseLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#StatusDatabaseLabel[dbState="connected"] {
    color: {{STATUS_FRESH}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusDatabaseLabel[dbState="disconnected"] {
    color: {{STATUS_DEGRADED}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusDatabaseLabel[dbState="unavailable"] {
    color: {{STATUS_DEGRADED}};
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLabel#StatusDatabaseLabel[dbState="checking"] {
    color: {{STATUS_STALE}};
}

QLabel#StatusLastUpdatedLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

QLabel#StatusSecurityNotice {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
}

