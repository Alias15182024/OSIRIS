    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QDateTimeEdit#StartTimeFilterEdit::drop-down,
QDateTimeEdit#EndTimeFilterEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: {{SPACE_5}}px;
    border-left: 1px solid {{BORDER}};
    border-top-right-radius: {{RADIUS_SMALL}}px;
    border-bottom-right-radius: {{RADIUS_SMALL}}px;
    background-color: transparent;
}

QDateTimeEdit#StartTimeFilterEdit::drop-down:hover,
QDateTimeEdit#EndTimeFilterEdit::drop-down:hover {
