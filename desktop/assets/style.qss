QLabel#ResourceTrendScopeBadge[scope="partial"],
QLabel#ResourceTrendScopeBadge[scope="retained"] {
    color: {{STATUS_STALE}};
    border-color: {{STATUS_STALE}};
}

QLabel#ResourceTrendScopeBadge[scope="failed"] {
    color: {{SEVERITY_HIGH}};
    border-color: {{SEVERITY_HIGH}};
}

QLabel#ResourceTrendScopeBadge[scope="empty"],
QLabel#ResourceTrendScopeBadge[scope="loading"],
QLabel#ResourceTrendScopeBadge[scope="none"] {
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QComboBox#ResourceTrendModeCombo {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    min-height: {{SPACE_6}}px;
}

QComboBox#ResourceTrendModeCombo:focus {
    border-color: {{ACCENT_FOCUS}};
}

QWidget#ResourceTrendLegend {
    background-color: transparent;
}

QLabel#ResourceTrendLegendCpu,
QLabel#ResourceTrendLegendMemory,
QLabel#ResourceTrendLegendDisk {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QWidget#ResourceTrendCanvas {
    background-color: {{SURFACE_0}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
}

/* -----------------------------------------------------------------------------
   17. Files Explorer View
   ----------------------------------------------------------------------------- */

QFrame#FilesStatusBanner {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
    padding: {{SPACE_3}}px {{SPACE_4}}px;
}

QFrame#FilesStatusBanner[state="loading"] {
    border-color: {{ACCENT}};
    background-color: {{SURFACE_1}};
}

QFrame#FilesStatusBanner[state="failed"] {
    border-color: {{SEVERITY_CRITICAL}};
    background-color: {{SURFACE_1}};
}

QFrame#FilesStatusBanner[state="empty"] {
    border-color: {{BORDER}};
    background-color: {{SURFACE_1}};
}

QFrame#FilesStatusBanner[state="not_loaded"] {
    border-color: {{BORDER}};
    background-color: {{SURFACE_1}};
}

QLabel#FilesStatusBannerTitle {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_STANDARD_BODY}}px;
    font-weight: {{FONT_WEIGHT_SEMIBOLD}};
}

QLabel#FilesStatusBannerMessage {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

QPushButton#RetryFilesButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QPushButton#RetryFilesButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{SEVERITY_CRITICAL}};
}

QPushButton#RetryFilesButton:pressed {
    background-color: {{SURFACE_3}};
}

QPushButton#QuickResetFilesFiltersButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QPushButton#QuickResetFilesFiltersButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QPushButton#QuickResetFilesFiltersButton:pressed {
    background-color: {{SURFACE_3}};
}

QTableView#FilesTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    gridline-color: {{BORDER}};
    selection-background-color: {{SURFACE_3}};
    selection-color: {{TEXT_PRIMARY}};
}

QFrame#FilesFilterBar {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_MEDIUM}}px;
    padding: {{SPACE_3}}px;
}

QLabel#FilesPathFilterLabel,
QLabel#FilesTypeFilterLabel,
QLabel#FilesHostIdFilterLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QLineEdit#FilesPathFilterInput,
QComboBox#FilesTypeFilterCombo,
QLineEdit#FilesHostIdFilterInput {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    min-height: {{SPACE_6}}px;
}

QLineEdit#FilesPathFilterInput:focus,
QComboBox#FilesTypeFilterCombo:focus,
QLineEdit#FilesHostIdFilterInput:focus {
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#ApplyFilesFiltersButton {
    background-color: {{ACCENT}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{ACCENT}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#ApplyFilesFiltersButton:hover {
    background-color: {{ACCENT_FOCUS}};
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#ApplyFilesFiltersButton:pressed {
    background-color: {{ACCENT}};
}

QPushButton#ApplyFilesFiltersButton:disabled {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QPushButton#ResetFilesFiltersButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#ResetFilesFiltersButton:hover {
    background-color: {{SURFACE_3}};
    color: {{TEXT_PRIMARY}};
    border-color: {{BORDER}};
}

QPushButton#ResetFilesFiltersButton:pressed {
    background-color: {{SURFACE_1}};
}

QPushButton#ResetFilesFiltersButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
}

QLabel#FilesFilterValidationLabel {
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
    padding-left: {{SPACE_2}}px;
}

QLabel#FilesFilterValidationLabel[error="true"] {
    color: {{SEVERITY_CRITICAL}};
}

QLabel#FilesFilterValidationLabel[error="false"] {
    color: {{TEXT_SECONDARY}};
}

QFrame#FilesPaginationFrame {
    background-color: transparent;
    border: none;
}

QPushButton#PrevFilesPageButton,
QPushButton#NextFilesPageButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#PrevFilesPageButton:hover,
QPushButton#NextFilesPageButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QPushButton#PrevFilesPageButton:pressed,
QPushButton#NextFilesPageButton:pressed {
    background-color: {{SURFACE_1}};
    border-color: {{ACCENT}};
}

QPushButton#PrevFilesPageButton:disabled,
QPushButton#NextFilesPageButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

QLabel#FilesPageRangeLabel {
    color: {{TEXT_SECONDARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    padding: 0px {{SPACE_2}}px;
}

QPushButton#RefreshFilesButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#RefreshFilesButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{BORDER}};
}

QPushButton#RefreshFilesButton:pressed {
    background-color: {{SURFACE_1}};
    border-color: {{ACCENT}};
}

QPushButton#RefreshFilesButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* -----------------------------------------------------------------------------
   18. Global Error & Degraded States Banner (Phase 1.7M)
   ----------------------------------------------------------------------------- */

QFrame#GlobalErrorBanner {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    margin: {{SPACE_1}}px {{SPACE_4}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
}

QFrame#GlobalErrorBanner[bannerType="disconnected"] {
    background-color: {{SURFACE_2}};
    border: 1px solid {{STATUS_DEGRADED}};
}

QFrame#GlobalErrorBanner[bannerType="degraded"] {
    background-color: {{SURFACE_2}};
    border: 1px solid {{STATUS_STALE}};
}

QLabel#ErrorBannerIndicator {
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_BOLD}};
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    border-radius: {{RADIUS_SMALL}}px;
}

QLabel#ErrorBannerIndicator[bannerType="disconnected"] {
    color: {{STATUS_DEGRADED}};
}

QLabel#ErrorBannerIndicator[bannerType="degraded"] {
    color: {{STATUS_STALE}};
}

QLabel#ErrorBannerMessage {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}

QPushButton#ErrorBannerRetryButton {
    background-color: {{SURFACE_2}};
    color: {{TEXT_PRIMARY}};
    border: 1px solid {{BORDER}};
    border-radius: {{RADIUS_SMALL}}px;
    padding: {{SPACE_1}}px {{SPACE_3}}px;
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
    min-height: {{SPACE_6}}px;
}

QPushButton#ErrorBannerRetryButton:hover {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT_FOCUS}};
}

QPushButton#ErrorBannerRetryButton:pressed {
    background-color: {{SURFACE_1}};
    border-color: {{ACCENT}};
}

QPushButton#ErrorBannerRetryButton:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border-color: {{BORDER}};
}

/* -----------------------------------------------------------------------------
   19. Root Execution Security Warning Banner (Phase 1.7N)
   ----------------------------------------------------------------------------- */

QFrame#RootWarningBanner {
    background-color: {{SURFACE_2}};
    border: 1px solid {{STATUS_STALE}};
    border-radius: {{RADIUS_SMALL}}px;
    margin: {{SPACE_1}}px {{SPACE_4}}px;
    padding: {{SPACE_1}}px {{SPACE_2}}px;
}

QLabel#RootWarningIndicator {
    color: {{STATUS_STALE}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_BOLD}};
    padding: {{SPACE_1}}px {{SPACE_2}}px;
    border-radius: {{RADIUS_SMALL}}px;
}

QLabel#RootWarningMessage {
    color: {{TEXT_PRIMARY}};
    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_REGULAR}};
}



