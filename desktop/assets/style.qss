    font-size: {{FONT_SIZE_SMALL_METADATA}}px;
    font-weight: {{FONT_WEIGHT_MEDIUM}};
}

QComboBox#SeverityFilterComboBox,
QLineEdit#SourceFilterInput,
QLineEdit#EventTypeFilterInput,
QLineEdit#PidFilterInput,
QLineEdit#HostIdFilterInput,
QDateTimeEdit#StartTimeFilterEdit,
